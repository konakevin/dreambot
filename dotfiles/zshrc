default_username='kevin.mchenry'

if (( ${terminfo[colors]:-0} >= 256 )); then
  PROMPT_MAGENTA="%F{9}"
  PROMPT_ORANGE="%F{172}"
  PROMPT_GREEN="%F{190}"
  PROMPT_PURPLE="%F{141}"
  PROMPT_WHITE="%F{255}"
else
  PROMPT_MAGENTA="%F{magenta}"
  PROMPT_ORANGE="%F{yellow}"
  PROMPT_GREEN="%F{green}"
  PROMPT_PURPLE="%F{red}"
  PROMPT_WHITE="%F{white}"
fi
PROMPT_BOLD="%B"
PROMPT_RESET="%b%f"

function _git_info() {
  git rev-parse --is-inside-work-tree &>/dev/null || return
  local branch=$(git symbolic-ref -q HEAD 2>/dev/null | sed 's|^refs/heads/||')
  local dirty=""
  git diff --quiet --ignore-submodules HEAD &>/dev/null || dirty="*"
  echo "${PROMPT_WHITE} on ${PROMPT_PURPLE}${branch}${dirty}"
}

function _usernamehost() {
  if [[ $USER != $default_username ]]; then
    echo "${PROMPT_MAGENTA}${USER} ${PROMPT_WHITE}at ${PROMPT_ORANGE}%m ${PROMPT_WHITE}in "
  fi
}

# Update iTerm2 tab/title
function _set_title() {
  print -Pn "\e]2;%~\a"
  print -Pn "\e]1;%1~\a"
}
add-zsh-hook precmd _set_title

setopt PROMPT_SUBST
PROMPT='${PROMPT_BOLD}$(_usernamehost)${PROMPT_GREEN}%~$(_git_info)${PROMPT_WHITE}
$ ${PROMPT_RESET}'

